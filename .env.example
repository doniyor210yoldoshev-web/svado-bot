# BotFather'dan olingan token (BU YERGA HAQIQIY TOKEN YOZMANG!)
BOT_TOKEN=123456789:replace-with-your-bot-token

# Adminlarning Telegram ID lari (vergul bilan)
ADMIN_IDS=123456789

# --- Ma'lumotlar bazasi ---------------------------------------------------
# Bo'sh yoki "sqlite..." bo'lsa lokal data/market.db ishlatiladi.
# Render'da PostgreSQL uchun: postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# Ixtiyoriy: SQLite fayllari yo'li
# DB_PATH=data/market.db
# FSM_DB_PATH=data/fsm.db

# --- Shifrlash ------------------------------------------------------------
# Bo'sh qoldirilsa, data/fernet.key avtomatik yaratiladi.
# Yangi kalit: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- To'lov ---------------------------------------------------------------
# manual -> karta orqali qo'lda tasdiqlash
PAYMENT_PROVIDER=manual
PAYMENT_CARD=8600 0000 0000 0000
PAYMENT_HOLDER=Marketplace Admin

# Yordam uchun Telegram username (@ belgisisiz)
SUPPORT_USERNAME=

# --- Til ------------------------------------------------------------------
DEFAULT_LANG=uz

# --- Biznes qoidalari -----------------------------------------------------
COMMISSION_PERCENT=8
CHECK_MINUTES=10
PENALTY_PERCENT=10
PENALTY_INTERVAL_MINUTES=10
AUTO_COMPLETE_MINUTES=60
MIN_PRICE=1000
MIN_TOPUP=1000
MIN_WITHDRAW=5000
MAX_TOPUP=50000000
PAGE_SIZE=10

# --- Test rejimi ----------------------------------------------------------
TEST_INITIAL_BALANCE=1000000
TEST_MAX_ACCOUNTS=10
