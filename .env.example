# BotFather'dan olingan token (BU YERGA HAQIQIY TOKEN YOZMANG!)
BOT_TOKEN=123456789:replace-with-your-bot-token

# Adminlarning Telegram ID lari (vergul bilan)
ADMIN_IDS=123456789

# --- Ma'lumotlar bazasi ---------------------------------------------------
# Bo'sh yoki "sqlite..." bo'lsa lokal data/market.db ishlatiladi.
# Render'da PostgreSQL uchun: postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# Ixtiyoriy: SQLite fayllari yo'li
# DB_PATH=data/market.db
# FSM_DB_PATH=data/fsm.db

# --- Shifrlash ------------------------------------------------------------
# Bo'sh qoldirilsa, data/fernet.key avtomatik yaratiladi.
# Yangi kalit: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- To'lov ---------------------------------------------------------------
# manual -> karta orqali qo'lda tasdiqlash
# click  -> Click (click.uz) SHOP API, avtomatik to'ldirish
# hamyon -> HamyonAPI (hamyon-api.uz) HUMO/UZCARD, avtomatik to'ldirish
PAYMENT_PROVIDER=manual
PAYMENT_CARD=8600 0000 0000 0000
PAYMENT_HOLDER=Marketplace Admin

# --- Click (click.uz) -----------------------------------------------------
# merchant.click.uz kabinetidan olinadi. PAYMENT_PROVIDER=click bo'lganda kerak.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
# Ochiq HTTPS manzil (Render domeni), masalan: https://marketplace-bot.onrender.com
PUBLIC_BASE_URL=

# --- HamyonAPI (hamyon-api.uz) --------------------------------------------
# @HamyonAPIBot dan olinadi. PAYMENT_PROVIDER=hamyon bo'lganda kerak.
HAMYON_API_URL=https://hamyon-api.uz
HAMYON_SHOP_ID=
HAMYON_SHOP_KEY=

# Yordam uchun Telegram username (@ belgisisiz)
SUPPORT_USERNAME=

# --- Til ------------------------------------------------------------------
DEFAULT_LANG=uz

# --- Biznes qoidalari -----------------------------------------------------
COMMISSION_PERCENT=8
CHECK_MINUTES=10
PENALTY_PERCENT=10
PENALTY_INTERVAL_MINUTES=10
AUTO_COMPLETE_MINUTES=60
MIN_PRICE=1000
MIN_TOPUP=1000
MIN_WITHDRAW=5000
MAX_TOPUP=50000000
PAGE_SIZE=10

# --- Test rejimi ----------------------------------------------------------
TEST_INITIAL_BALANCE=1000000
TEST_MAX_ACCOUNTS=10
